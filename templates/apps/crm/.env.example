# ===========================================================================
# OBRIGATÓRIO — tudo sai do painel do Supabase, em Settings.
#
# Preencheu isto? O CRM cria as tabelas sozinho no primeiro acesso e abre uma
# tela de boas-vindas para você criar a sua conta de administrador.
# NÃO existe SQL para rodar à mão.
#
# Nuvem:       https://supabase.com → New project
# Self-hosted: suba pela skill coolify e use a URL do Kong
# ===========================================================================

# Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API → service_role. Só no servidor: ignora as regras de permissão.
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string, porta 5432.
#
# ATENÇÃO: é a credencial mais poderosa do pacote — dá acesso ao banco inteiro,
# ignorando as regras de permissão. Nunca exponha no navegador, nunca comite.
# É lida apenas por código de servidor.
#
# NÃO use a porta 6543 (pooler de transação): ela não sustenta a trava que a
# criação das tabelas precisa. O CRM avisa na tela se você errar a porta.
DATABASE_URL=

# Protege POST /api/leads, a rota que o n8n e o formulário do site usam.
# Invente uma frase longa. Sem ela, a rota fica desabilitada de propósito.
CRM_API_KEY=

# ===========================================================================
# OPCIONAL — cada bloco liga uma integração. Sem eles, a tela correspondente
# explica o que falta em vez de quebrar.
# ===========================================================================

N8N_URL=
N8N_API_KEY=

EVOLUTION_URL=
EVOLUTION_KEY=
EVOLUTION_INSTANCIA=

# Organização que recebe os leads vindos da API sem organizacao_id.
CRM_ORGANIZACAO_PADRAO=

# Só em container. Rodando local, deixe em branco: o Next escolhe uma porta
# livre sozinho e mostra o endereço no terminal.
PORT=

# ===========================================================================
# Sem NADA preenchido, o CRM abre em modo demonstração: sem login, com dados
# de exemplo guardados no navegador. Serve para apresentar na hora.
# ===========================================================================
