# Porta do CRM
PORT=3333

# Onde o banco JSON é gravado
DATA_DIR=./data

# n8n — webhook que recebe os eventos do CRM
# eventos: lead.criado | lead.etapa_alterada | estoque.abaixo_do_minimo | whatsapp.mensagem_recebida
N8N_WEBHOOK_URL=

# WhatsApp via Evolution API
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Origem permitida no CORS (use o domínio do site em produção)
CORS_ORIGIN=*
