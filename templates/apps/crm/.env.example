# ---------------------------------------------------------------------------
# Supabase — deixe TUDO em branco para abrir em modo demonstração (sem login,
# dados só no navegador). Preencha para valer com login e banco de verdade.
#
# Nuvem:       https://supabase.com → New project → Settings → API
# Self-hosted: suba pela skill coolify e use a URL do Kong
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor. Ignora RLS — nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Protege POST /api/leads (a rota que o n8n usa). Gere uma chave forte.
CRM_API_KEY=

# Organização que recebe os leads vindos da API sem organizacao_id
CRM_ORGANIZACAO_PADRAO=

PORT=3333
