{
  "name": "crm-automarketing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-automarketing",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-crm",
      "name": "Evento do CRM",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "leftValue": "={{ $json.body.evento }}", "rightValue": "lead.criado", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "lead_criado" },
            { "conditions": { "options": { "caseSensitive": true }, "conditions": [ { "leftValue": "={{ $json.body.evento }}", "rightValue": "estoque.abaixo_do_minimo", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "outputKey": "estoque_baixo" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "switch-evento",
      "name": "Qual evento?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.body.dados.telefone, text: 'Olá ' + $json.body.dados.nome + '! Recebemos seu contato e já vamos te responder.' }) }}",
        "options": {}
      },
      "id": "boas-vindas",
      "name": "WhatsApp de boas-vindas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $env.TELEFONE_GESTOR, text: 'Estoque baixo: ' + $json.body.dados.nome + ' (' + $json.body.dados.sku + ') restam ' + $json.body.dados.estoque }) }}",
        "options": {}
      },
      "id": "alerta-estoque",
      "name": "Alerta de estoque ao gestor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 340]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify({ ok: true }) }}", "options": {} },
      "id": "responder",
      "name": "Responder CRM",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Evento do CRM": { "main": [[{ "node": "Qual evento?", "type": "main", "index": 0 }]] },
    "Qual evento?": {
      "main": [
        [{ "node": "WhatsApp de boas-vindas", "type": "main", "index": 0 }],
        [{ "node": "Alerta de estoque ao gestor", "type": "main", "index": 0 }],
        [{ "node": "Responder CRM", "type": "main", "index": 0 }]
      ]
    },
    "WhatsApp de boas-vindas": { "main": [[{ "node": "Responder CRM", "type": "main", "index": 0 }]] },
    "Alerta de estoque ao gestor": { "main": [[{ "node": "Responder CRM", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
